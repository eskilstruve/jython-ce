<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
        https://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.eskilstruve</groupId>
    <artifactId>@ARTIFACT-ID@</artifactId>
    <packaging>jar</packaging>
    <version>@PROJECT-VERSION@</version>

    <name>Jython-ce</name>
    <description>
        Jython-ce (Jython community edition) is a community-maintained fork of
        Jython, an implementation of the high-level, dynamic, object-oriented
        language Python written in 100% Pure Java, and seamlessly integrated with
        the Java platform. It thus allows you to run Python on any Java platform.
    </description>
    <url>https://github.com/eskilstruve/jython-ce</url>
    <inceptionYear>1997</inceptionYear>

    <organization>
        <name>Python Software Foundation</name>
        <url>https://www.python.org</url>
    </organization>

    <licenses>
        <license>
            <name>Jython Software License</name>
            <url>https://raw.githubusercontent.com/eskilstruve/jython-ce/master/LICENSE.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>eskilstruve</id>
            <name>Jython-ce Developers</name>
            <url>https://github.com/eskilstruve</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/eskilstruve/jython-ce.git</connection>
        <developerConnection>scm:git:git@github.com:eskilstruve/jython-ce.git</developerConnection>
        <url>https://github.com/eskilstruve/jython-ce</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/eskilstruve/jython-ce/issues</url>
    </issueManagement>

</project>
